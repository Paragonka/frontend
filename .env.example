# Default: relative URL through the vite dev-server proxy (/api -> http://localhost:8000,
# see vite.config.ts server.proxy). Same-origin, no CORS involved.
VITE_API_URL=/api/v1
# Cross-domain alternative (backend must allow it via CORS_ORIGINS):
# VITE_API_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LOCALE=pl

# Set to 'true' to enable MSW mock API in browser (no backend needed)
VITE_MSW_ENABLED=false
